<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>CryptoEdu</title>
    <link rel="stylesheet" href="/css/style.css">

</head>
<body>
<h2>Artykuły</h2>
<ul>
    <% articles.forEach(a => { %>
        <li>
            <h3><%= a.TITLE || a.title %></h3>
            <p><%= a.SUMMARY || a.summary %></p>
            <small><%= a.CREATED_AT || a.created_at %></small>
        </li>
    <% }) %>
</ul>
</body>
</html>