<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>CryptoEdu</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<h2>Artykuły</h2>

<div class="articles-grid">
    <% articles.forEach(a => { %>
        <a href="/articles/<%= a.id %>" class="article-card">
            <h3><%= a.title %></h3>
            <small><%= new Date(a.created_at).toLocaleDateString() %></small>
            <p><%= a.summary %></p>
        </a>
    <% }) %>
</div>

</body>
</html>