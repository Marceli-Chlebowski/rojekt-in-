<div class="admin-page">
    <div class="admin-card admin-card--wide">
        <div class="admin-page-header">
            <div>
                <div class="admin-breadcrumb">
                    <a href="/admin">Dashboard</a> / Reguły podatkowe
                </div>
        <h1>Reguły podatkowe</h1>
                <p class="admin-subtitle">
                    Twórz i edytuj Reguły podatkowe, które będą wykorzystywane w aplikacji.
                </p>
            </div>
                <div>
                    <a href="/admin/tax-rules/new"
                       class="admin-btn admin-btn-primary">
                        + Dodaj kraj
                    </a>
                </div>
        </div>

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
            <tr>
                <th>Kod</th>
                <th>Kraj</th>
                <th>Podatek (%)</th>
                <th>Długoterminowy (%)</th>
                <th>Dni</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            <% if (!rules || !rules.length) { %>
                <tr>
                    <td colspan="6">Brak reguł podatkowych.</td>
                </tr>
            <% } %>

            <% (rules || []).forEach(r => { %>
                <tr>
                    <td><%= r.country_code %></td>
                    <td><%= r.country_name %></td>
                    <td><%= r.tax_rate %></td>
                    <td><%= r.long_term_rate ?? '-' %></td>
                    <td><%= r.long_term_days ?? '-' %></td>
                    <td style="white-space:nowrap;">
                        <a class="admin-btn-small" href="/admin/tax-rules/<%= r.id %>/edit">Edytuj</a>

                        <form method="post" action="/admin/tax-rules/<%= r.id %>/delete" style="display:inline;"
                              onsubmit="return confirm('Na pewno usunąć regułę dla: <%= r.country_name %>?');">
                            <button type="submit"
                                    class="admin-btn-small admin-btn-small--danger">
                                Usuń
                            </button>
                        </form>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </div>
        <a href="/admin" class="admin-btn admin-btn-secondary"
           style="display:inline-flex; gap:6px; margin-top:18px;">
            ← Powrót
        </a>
    </div>
</div>
