<div class="admin-page">
    <div class="admin-card admin-card--wide">
        <div class="admin-breadcrumb">
            <a href="/admin">Dashboard</a> ›
            <a href="/admin/tax-rules">Podatki</a> ›
            <span><%= rule ? 'Edytuj regułę podatkową' : 'Dodaj regułę podatkową' %></span>
        </div>
        <div class="admin-page-header">

        <h1><%= rule ? 'Edytuj regułę podatkową' : 'Dodaj regułę podatkową' %></h1>
        </div>
    <form method="post" action="<%= action %>" class="admin-form-group">
        <div class="admin-form-group">
            <label class="admin-form-label">Kod kraju (np. PL)</label>
            <input name="country_code" maxlength="5" required
                   value="<%= rule ? rule.country_code : '' %>">
        </div>

        <div class="admin-form-group">
            <label class="admin-form-label">Nazwa kraju</label>
            <input name="country_name" maxlength="100" required
                   value="<%= rule ? rule.country_name : '' %>">
        </div>

        <div class="admin-form-group">
            <label class="admin-form-label">Stawka podatku (%)</label>
            <input name="tax_rate" type="number" step="0.01" min="0" required
                   value="<%= rule ? rule.tax_rate : '' %>">
        </div>


        <div class="admin-form-group">
            <label class="admin-form-label">Długoterminowa stawka (%) (opcjonalnie)</label>
            <input name="long_term_rate" type="number" step="0.01" min="0"
                   value="<%= rule && rule.long_term_rate != null ? rule.long_term_rate : '' %>">
        </div>

        <div class="admin-form-group">
            <label class="admin-form-label">Liczba dni do stawki długoterminowej (opcjonalnie)</label>
            <input name="long_term_days" type="number" step="1" min="0"
                   value="<%= rule && rule.long_term_days != null ? rule.long_term_days : '' %>">
        </div>

        <div style="margin-top: 20px; display:flex; gap:10px; flex-wrap:wrap;">
            <button type="submit" class="admin-btn admin-btn-primary">
                <%= rule ? 'Zapisz zmiany' : 'Dodaj regułę podatkową' %>
            </button>
            <a class="admin-btn admin-btn-secondary" href="/admin/tax-rules">Anuluj</a>
        </div>
    </form>
    </div>
</div>
