<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title><%= quiz.title %> - CryptoEdu</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
    <h1>Quiz: <%= quiz.title %></h1>
</header>

<main>
    <form action="/quiz/<%= quiz.id %>/submit" method="POST" class="quiz-form">
        <% questions.forEach((q, idx) => { %>
            <div class="question">
                <p><strong><%= idx + 1 %>. <%= q.question_text %></strong></p>
                <% q.options.forEach(opt => { %>
                    <label>
                        <input type="radio" name="q_<%= q.id %>" value="<%= opt.key %>">
                        <%= opt.key %>. <%= opt.text %>
                    </label><br>
                <% }) %>
            </div>
        <% }) %>
        <button type="submit" class="submit-btn">Sprawdź odpowiedzi</button>
    </form>
</main>

<footer>
    <p><a href="/quiz">Wróć do listy quizów</a></p>
</footer>
</body>
</html>