<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title><%= quiz.title %> - CryptoEdu</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header>
    <h1>Quiz: <%= quiz.title %></h1>
</header>

<main>
    <form action="/quiz/<%= quiz.id %>/submit" method="POST" class="quiz-form">
        <div class="millionaire-wrapper">
            <% questions.forEach((q, idx) => { %>
                <div class="millionaire-card">
                    <p><strong class="millionaire-question-text"><%= idx + 1 %>. <%= q.question_text %></strong></p>

                    <div class="millionaire-options">
                        <% q.options.forEach(opt => { %>
                            <label class="millionaire-answer" style="cursor:pointer;">
                                <input
                                        type="radio"
                                        name="q_<%= q.id %>"
                                        value="<%= opt.key %>"
                                        required
                                        style="margin-right:10px;"
                                />
                                <span class="millionaire-answer-label"><%= opt.key %>.</span>
                                <span class="millionaire-answer-text"><%= opt.text %></span>
                            </label>
                        <% }) %>
                    </div>
                </div>
            <% }) %>
        </div>

        <button type="submit" class="game-answer">Sprawdź odpowiedzi</button>
    </form>
</main>
<footer>
    <p><a href="/quiz">Wróć do listy quizów</a></p>
</footer>
</body>
</html>