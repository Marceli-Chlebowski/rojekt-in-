<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>CryptoEdu</title>
    <link rel="stylesheet" href="/css/style.css">

</head>
<body>
<h2>Rejestracja</h2>
<form method="post" action="/register">
    <input name="first_name" placeholder="Imię" /><br/>
    <input name="last_name" placeholder="Nazwisko" /><br/>
    <input name="email" placeholder="Email" required /><br/>
    <input name="dob" placeholder="YYYY-MM-DD" /><br/>
    <input name="password" type="password" placeholder="Hasło" required /><br/>
    <button type="submit">Zarejestruj</button>
</form>
</body>
</html>