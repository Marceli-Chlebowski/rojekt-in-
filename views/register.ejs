<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Rejestracja</title></head>
<main>
    <div class="form-card">
        <h1>Rejestracja</h1>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="flash error"><%= error %></div>
        <% } %>
        <form method="post" action="/auth/register">
            <div class="form-row">
                <input class="input" name="first_name" placeholder="Imię" required />
                <input class="input" name="last_name" placeholder="Nazwisko" required />
            </div>
            <input class="input" name="birth_date" type="date" required />
            <input class="input" name="email" type="email" placeholder="Email" required />
            <input class="input" name="username" placeholder="Login" required />
            <input class="input" name="password" type="password" placeholder="Hasło (min 8)" required />
            <div class="form-actions">
                <button class="btn" type="submit">Zarejestruj</button>
                <a href="/auth/login">Mam konto</a>
            </div>
        </form>
    </div>
</main>
</html>
