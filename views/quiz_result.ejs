<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>CryptoEdu</title>
    <link rel="stylesheet" href="/css/style.css">

</head>
<body>
<h2>Wynik quizu</h2>
<p>Twój wynik: <strong><%= score %></strong> / <strong><%= total %></strong></p>

<h3>Szczegóły</h3>
<ul>
    <% breakdown.forEach((b, idx) => { %>
        <li>
            <strong>Pytanie <%= idx+1 %>:</strong> <%= b.question || ('id ' + b.id) %><br/>
            Twoja odpowiedź: <%= b.selected || '—' %>
            <% if (b.isCorrect) { %>
                <span style="color:green">✔</span>
            <% } else { %>
                <span style="color:red">✖ (poprawna: <%= b.correct %>)</span>
            <% } %>
            <div>
                <small>Opcje:</small>
                <ul>
                    <li>A: <%= b.options.A %></li>
                    <li>B: <%= b.options.B %></li>
                    <li>C: <%= b.options.C %></li>
                    <li>D: <%= b.options.D %></li>
                </ul>
            </div>
        </li>
    <% }) %>
</ul>

<a href="/quiz">Zagraj ponownie</a>
</body>
</html>