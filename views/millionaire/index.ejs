<div class="millionaire-wrapper">
    <div class="millionaire-card">
        <h1 class="millionaire-title">🎮 Milionaire Quiz</h1>
        <p class="millionaire-subtitle">
            Answer <strong>10 questions</strong> about cryptocurrencies.
            Each correct answer increases your prize. One mistake ends the game!
        </p>

        <div class="millionaire-info">
            <h3>Rules</h3>
            <ul>
                <li>10 randomly selected questions.</li>
                <li>One correct answer per question.</li>
                <li>Two lifelines – each can be used once.</li>
            </ul>

            <h3>Lifelines</h3>
            <ul>
                <li><strong>50 : 50</strong> – removes two wrong answers.</li>
                <li><strong>Audience</strong> – shows audience vote percentages.</li>
            </ul>
        </div>

        <div class="millionaire-actions">
            <form method="get" action="/millionaire/start">
                <button class="btn millionaire-start-btn">
                    ▶️ Start Game
                </button>
            </form>

            <a href="/millionaire/leaderboard" class="btn btn-outline">
                🏆 Leaderboard
            </a>
        </div>
    </div>
</div>
