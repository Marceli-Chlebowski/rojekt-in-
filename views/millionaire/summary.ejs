<div class="millionaire-wrapper">
    <div class="millionaire-card">
        <h1 class="millionaire-title">Koniec gry</h1>

        <p class="millionaire-subtitle">
            Poprawne odpowiedzi: <strong><%= score %> / <%= total %></strong>
        </p>

        <p class="lead">
            Twoja wygrana:
            <strong><%= earnedPrize.toLocaleString('pl-PL') %> $</strong>
        </p>

        <% if (score === total) { %>
            <p class="muted">Gratulacje! Zdobywasz pełną pulę 🎉</p>
        <% } else if (score === 0) { %>
            <p class="muted">Tym razem się nie udało. Spróbuj ponownie!</p>
        <% } else { %>
            <p class="muted">Nieźle! Zawsze możesz poprawić swój wynik.</p>
        <% } %>

        <div class="millionaire-actions" style="margin-top: 24px;">
            <a href="/millionaire/start" class="btn">▶️ Zagraj ponownie</a>
            <a href="/millionaire/leaderboard" class="btn btn-outline">🏆 Ranking</a>
            <a href="/" class="btn btn-outline">Strona główna</a>
        </div>
    </div>
</div>
