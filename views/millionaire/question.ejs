<div class="millionaire-wrapper">
    <div class="millionaire-layout">
        <!-- LEWA STRONA – PYTANIE -->
        <div class="millionaire-card millionaire-question-card">
            <div class="millionaire-header-row">
                <div>
                    <h1 class="millionaire-title">Milionerzy</h1>
                    <p class="millionaire-subtitle">
                        Pytanie <strong><%= index %></strong> / <%= total %>
                    </p>
                </div>
                <div class="millionaire-current-prize">
                    Aktualna wygrana:
                    <span><%= currentPrize.toLocaleString('pl-PL') %> $</span>
                </div>
            </div>

            <!-- KOŁA RATUNKOWE -->
            <div class="millionaire-lifelines">
                <form method="post" action="/millionaire/lifeline">
                    <input type="hidden" name="type" value="fifty">
                    <button
                            class="millionaire-lifeline-btn"
                            <%= lifelines.fiftyUsed ? 'disabled' : '' %>
                    >
                        50 : 50
                    </button>
                </form>

                <form method="post" action="/millionaire/lifeline">
                    <input type="hidden" name="type" value="audience">
                    <button
                            class="millionaire-lifeline-btn"
                            <%= lifelines.audienceUsed ? 'disabled' : '' %>
                    >
                        👥 Publiczność
                    </button>
                </form>
            </div>

            <% if (audienceVisible) { %>
                <% if (audienceHint) { %>
                    <p class="millionaire-hint">
                        👥 Publiczność:
                        <span><strong>A</strong>: <%= audienceHint.perc_a || 0 %>%</span>
                        <span><strong>B</strong>: <%= audienceHint.perc_b || 0 %>%</span>
                        <span><strong>C</strong>: <%= audienceHint.perc_c || 0 %>%</span>
                        <span><strong>D</strong>: <%= audienceHint.perc_d || 0 %>%</span>
                    </p>
                <% } else { %>
                    <p class="millionaire-hint">
                        👥 Brak danych publiczności dla tego pytania.
                    </p>
                <% } %>
            <% } %>

            <!-- PYTANIE -->
            <div class="millionaire-question-text">
                <%= question.question_text %>
            </div>

            <!-- ODPOWIEDZI -->
            <form method="post" action="/millionaire/answer">
                <div class="millionaire-options">
                    <% const hidden = hiddenOptions || []; %>

                    <% ['A','B','C','D'].forEach(letter => {
                        const field =
                                letter === 'A' ? 'opt_a' :
                                        letter === 'B' ? 'opt_b' :
                                                letter === 'C' ? 'opt_c' : 'opt_d';

                        if (hidden.includes(letter)) return;
                    %>
                    <button
                            type="submit"
                            name="answer"
                            value="<%= letter %>"
                            class="millionaire-answer"
                    >
                        <span class="millionaire-answer-label"><%= letter %>.</span>
                        <span class="millionaire-answer-text"><%= question[field] %></span>
                    </button>
                    <% }) %>
                </div>
            </form>
        </div>

        <!-- PRAWA STRONA – DRABINA NAGRÓD -->
        <aside class="millionaire-ladder-card">
            <h3>Drabina nagród</h3>
            <ul class="millionaire-ladder">
                <% for (let i = prizeLadder.length - 1; i >= 0; i--) {
                    const level = i + 1;
                    const amount = prizeLadder[i];
                    const isCurrent = level === index;
                %>
                <li class="<%= isCurrent ? 'active' : '' %>">
                    <span class="ladder-level"><%= level %>.</span>
                    <span class="ladder-amount"><%= amount.toLocaleString('pl-PL') %> $</span>
                </li>
                <% } %>
            </ul>
        </aside>
    </div>
</div>
