<div class="millionaire-wrapper">
    <div class="millionaire-card">
        <h1 class="millionaire-title">🏆 Ranking Milionerów</h1>
        <p class="millionaire-subtitle">
            Najlepsze wyniki w grze Milionerzy.
        </p>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>#</th>
                    <th>Użytkownik</th>
                    <th>Najlepszy wynik</th>
                    <th>Najwyższa wygrana</th>
                    <th>Ostatnia gra</th>
                </tr>
                </thead>
                <tbody>
                <% if (!rows.length) { %>
                    <tr>
                        <td colspan="5">Brak wyników. Bądź pierwszy!</td>
                    </tr>
                <% } %>
                <% rows.forEach((row, idx) => { %>
                    <tr>
                        <td><%= idx + 1 %></td>
                        <td><%= row.username || row.email || 'Anonim' %></td>
                        <td><%= row.best_score %> / 10</td>
                        <td><%= row.best_amount.toLocaleString('pl-PL') %> $</td>
                        <td><%= row.last_played.toLocaleString('pl-PL') %></td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>

        <div class="millionaire-actions" style="margin-top: 20px;">
            <a href="/millionaire/start" class="btn">▶️ Graj</a>
            <a href="/millionaire" class="btn btn-outline">Powrót do startu</a>
        </div>
    </div>
</div>
