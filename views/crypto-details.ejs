<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>CryptoEdu</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        #priceChart {
            width: 100%;
            max-width: 100%;
            height: 300px;
            min-height: 300px;
            max-height: 300px;
            display: block;
            box-sizing: border-box;
        }
        @media (max-width: 600px) {
            #priceChart {
                height: 220px;
                min-height: 220px;
                max-height: 220px;
            }
        }
        .chart-controls {
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
        }
        #timeRange {
            padding: 4px 8px;
            font-size: 14px;
        }
    </style>
</head>
<body>
<h2><%= coin?.name || 'N/A' %> (<%= coin?.symbol?.toUpperCase() || 'N/A' %>)</h2>
<p>Aktualna cena: $<%= coin?.market_data?.current_price?.usd !== undefined ? coin.market_data.current_price.usd : 'N/A' %></p>
<p>Kapitalizacja: $<%= coin?.market_data?.market_cap?.usd !== undefined ? coin.market_data.market_cap.usd : 'N/A' %></p>
<div class="chart-controls">
    <label for="timeRange">Przedział czasowy:</label>
    <select id="timeRange">
        <option value="7" <%= chartDays == 7 ? 'selected' : '' %>>7 dni</option>
        <option value="30" <%= chartDays == 30 ? 'selected' : '' %>>30 dni</option>
        <option value="90" <%= chartDays == 90 ? 'selected' : '' %>>90 dni</option>
        <option value="180" <%= chartDays == 180 ? 'selected' : '' %>>180 dni</option>
        <option value="365" <%= chartDays == 365 ? 'selected' : '' %>>1 rok</option>
    </select>
</div>

<canvas id="priceChart" style="height: 300px;"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
let priceChartInstance = null;
const ctx = document.getElementById('priceChart').getContext('2d');

async function fetchChartData(days) {
    try {
        const res = await fetch(`/api/coin/<%= coin.id %>/market_chart?days=${days}`);
        const chartData = await res.json();

        const labels = chartData.prices.map(p => new Date(p[0]).toLocaleDateString('pl-PL'));
        const data = chartData.prices.map(p => p[1]);

        if (priceChartInstance) priceChartInstance.destroy();

        priceChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels,
                datasets: [{
                    label: 'Cena USD',
                    data,
                    borderColor: 'rgba(75,192,192,1)',
                    backgroundColor: 'rgba(75,192,192,0.2)',
                    fill: true,
                    tension: 0.3,
                    pointRadius: 2,
                    pointHoverRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { title: { display: true, text: 'Data' } },
                    y: { title: { display: true, text: 'Cena (USD)' }, beginAtZero: false }
                }
            }
        });
    } catch (err) {
        console.error('Błąd pobierania danych wykresu:', err);
    }
}

// inicjalizacja przy ładowaniu
fetchChartData(<%= chartDays %>);

document.getElementById('timeRange').addEventListener('change', (e) => {
    fetchChartData(e.target.value);
});
</script>
</body>
</html>