<main>
    <div class="coin-header">
        <img src="<%= coin.image.large %>" alt="<%= coin.name %> logo">
        <div>
            <h1 style="margin:0; font-size:28px;"><%= coin.name %> (<%= coin.symbol.toUpperCase() %>)</h1>
            <div class="coin-meta">
                Aktualna cena: $<%= coin.market_data?.current_price?.usd?.toLocaleString() %>
                <% if (typeof coin.market_data?.price_change_percentage_24h === 'number') { %>
                    <span class="<%= coin.market_data.price_change_percentage_24h >= 0 ? 'up' : 'down' %>">
            (<%= coin.market_data.price_change_percentage_24h.toFixed(2) %>%)
          </span>
                <% } %>
            </div>
        </div>
    </div>

    <div class="chart-card">
        <h3 style="margin:0 0 12px;">Wykres (ostatnie <%= chartDays %> dni)</h3>
        <canvas id="priceChart" height="220"></canvas>
    </div>

    <div class="card" style="margin-top:20px;">
        <h2>Opis</h2>
        <% if (coin.description?.pl) { %>
            <p style="line-height:1.6;"><%= coin.description.pl.replace(/<[^>]+>/g, '') %></p>
        <% } else if (coin.description?.en) { %>
            <p style="line-height:1.6;"><%= coin.description.en.replace(/<[^>]+>/g, '') %></p>
        <% } else { %>
            <p class="muted">Brak opisu w bazie CoinGecko.</p>
        <% } %>
    </div>

    <div class="card" style="margin-top:20px;">
        <h2>Informacje rynkowe</h2>
        <ul style="list-style:none; padding:0; margin:0;">
            <li><strong>Ranking rynkowy:</strong> <%= coin.market_cap_rank || '—' %></li>
            <li><strong>Kapitalizacja rynkowa:</strong> $<%= coin.market_data?.market_cap?.usd?.toLocaleString() || '—' %></li>
            <li><strong>Wolumen 24h:</strong> $<%= coin.market_data?.total_volume?.usd?.toLocaleString() || '—' %></li>
            <li><strong>Najwyższa cena 24h:</strong> $<%= coin.market_data?.high_24h?.usd?.toLocaleString() || '—' %></li>
            <li><strong>Najniższa cena 24h:</strong> $<%= coin.market_data?.low_24h?.usd?.toLocaleString() || '—' %></li>
            <li><strong>Strona projektu:</strong>
                <% if (coin.links?.homepage?.[0]) { %>
                    <a href="<%= coin.links.homepage[0] %>" target="_blank"><%= coin.links.homepage[0] %></a>
                <% } else { %>
                    <span class="muted">Brak</span>
                <% } %>
            </li>
        </ul>
    </div>
</main>

<script>
    (function loadChartAndRender() {
        const s = document.createElement('script');
        s.src = "https://cdn.jsdelivr.net/npm/chart.js";
        s.onload = renderChart;
        s.onerror = () => console.error('Nie udało się załadować Chart.js');
        document.body.appendChild(s);
    })();

    async function renderChart() {
        try {
            const res = await fetch(`/api/coin/<%= coin.id %>/market_chart?days=<%= chartDays %>`);
            const { prices } = await res.json();

            const labels = prices.map(p => {
                const d = new Date(p[0]);
                return d.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit' });
            });
            const series = prices.map(p => p[1]);

            const ctx = document.getElementById('priceChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Cena (USD)',
                        data: series,
                        borderColor: '#6d28d9',
                        borderWidth: 2,
                        tension: 0.25,
                        fill: false,
                        pointRadius: 0,
                    }]
                },
                options: {
                    animation: false,
                    scales: {
                        x: {
                            ticks: { color: '#6b7280', maxTicksLimit: 8 },
                            grid: { display: false }
                        },
                        y: {
                            ticks: {
                                color: '#6b7280',
                                callback: v => '$' + Number(v).toLocaleString()
                            },
                            grid: { color: '#e5e7eb' }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                title: (items) => {
                                    const i = items[0].dataIndex;
                                    const d = new Date(prices[i][0]);
                                    return d.toLocaleString('pl-PL');
                                },
                                label: (ctx) => `$${Number(ctx.parsed.y).toLocaleString()}`
                            }
                        }
                    }
                }
            });
        } catch (err) {
            console.error('Błąd ładowania wykresu:', err);
        }
    }
</script>
