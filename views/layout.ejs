<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8" />
    <title>CryptoEdu</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/admin.css">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>
<body
        data-logged-in="<%= user ? '1' : '0' %>"
        style="background:#f7f7f8; margin:0; font-family:system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;">
<header style="padding:12px;">
    <nav class="appbar">
        <div class="menu">
            <a href="/" class="brand">CryptoEdu</a>

            <a href="/articles"
               class="<%= (req.originalUrl || '').startsWith('/articles') ? 'active' : '' %>">
                Artykuły
            </a>

            <a href="/quiz"
               class="<%= (req.originalUrl || '').startsWith('/quiz') ? 'active' : '' %>">
                Quiz
            </a>

            <a href="/millionaire"
               class="<%= (req.originalUrl || '').startsWith('/millionaire') ? 'active' : '' %>">
                Milionerzy
            </a>

            <a href="/tax"
               class="<%= (req.originalUrl || '').startsWith('/tax') ? 'active' : '' %>">
                Kalkulator podatkowy
            </a>

            <a href="/favorites"
               class="<%= (req.originalUrl || '').startsWith('/favorites') ? 'active' : '' %>">
                Ulubione
            </a>

            <% if (isAdmin) { %>
                <a href="/admin"
                   class="<%= (req.originalUrl || '').startsWith('/admin') ? 'active' : '' %>">
                    Panel Admina
                </a>
            <% } %>
        </div>
        <div class="user">
            <% if (user) { %>
                <a href="/user/profile">Profil</a>
                <span class="muted"><strong><%= user.username %></strong></span>
                <form method="post" action="/auth/logout" style="display:inline;">
                    <button type="submit" class="btn">Wyloguj</button>
                </form>
            <% } else { %>
                <a href="/auth/register" class="btn btn-outline">Rejestracja</a>
                <a href="/auth/login" class="btn">Logowanie</a>
            <% } %>
        </div>
    </nav>
</header>

<main style="max-width:1100px; margin:0 auto; padding:0 16px 40px;">
    <% if (Array.isArray(success) && success.length) { %>
        <div class="flash success">
            <% success.forEach(msg => { %><div><%= msg %></div><% }) %>
        </div>
    <% } %>
    <% if (Array.isArray(error) && error.length) { %>
        <div class="flash error">
            <% error.forEach(msg => { %><div><%= msg %></div><% }) %>
        </div>
    <% } %>

    <%- body %>
</main>
</body>
</html>
