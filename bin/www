#!/usr/bin/env node

/**
 * Zależności modułu.
 */

var app = require('../app');
var debug = require('debug')('rojekt-in:server');
var http = require('http');

/**
 * Pobranie portu ze zmiennych środowiskowych
 * i zapisanie go w aplikacji Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Utworzenie serwera HTTP.
 */

var server = http.createServer(app);

/**
 * Nasłuchiwanie na podanym porcie,
 * na wszystkich interfejsach sieciowych.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalizacja portu do liczby, ciągu znaków lub false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // nazwany potok (pipe)
    return val;
  }

  if (port >= 0) {
    // numer portu
    return port;
  }

  return false;
}

/**
 * Obsługa zdarzenia "error" serwera HTTP.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
      ? 'Pipe ' + port
      : 'Port ' + port;

  // obsługa konkretnych błędów nasłuchiwania
  // z czytelnymi komunikatami
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' wymaga podwyższonych uprawnień');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' jest już używany');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Obsługa zdarzenia "listening" serwera HTTP.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
      ? 'pipe ' + addr
      : 'port ' + addr.port;
  debug('Nasłuchiwanie na ' + bind);
}
